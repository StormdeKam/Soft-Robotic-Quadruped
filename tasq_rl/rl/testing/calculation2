from sympy import symbols, Eq, cos, sin, solve, simplify

# Define symbols
p1, p2, p3, v1, v2, mp, l, theta = symbols('p1 p2 p3 v1 v2 mp l theta')

# Define equations
eq1 = Eq((p1 +p2 +p3)/3, mp)
eq2 = Eq(p1-p2*sin(theta)-p3*sin(theta), v1)
eq3 = Eq(-p2*cos(theta)+p3*cos(theta), v2)

# Solve the system for f1, f2, f3
solution = solve((eq1, eq2, eq3), (p1, p2, p3), simplify=True)

# Simplify the results
solution_simplified = {k: simplify(v) for k, v in solution.items()}
print(solution_simplified)
